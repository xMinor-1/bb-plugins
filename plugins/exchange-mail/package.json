{
  "name": "bb-plugin-exchange-mail",
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.104"
  },
  "bb": {
    "name": "Exchange Mail",
    "description": "Read your Exchange mailbox and calendar in bb and answer from them. Agents on the models you approve can read, search and draft replies and see your meetings and free time; a draft leaves only when you press Send. Signs in with your Windows account, or a password kept in the OS store.",
    "branding": {
      "icon": "Mail"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./src/host.ts",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.3.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.104",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^29.1.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^4.1.12"
  },
  "description": "Read and answer Exchange mail and read the Exchange calendar in bb. Agents on approved models read and search mail, see meetings and free time, and prepare reply drafts; only a person sends them.",
  "license": "MIT",
  "author": "Foma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xMinor-1/bb-plugins.git",
    "directory": "plugins/exchange-mail"
  },
  "keywords": [
    "bb-plugin",
    "exchange",
    "ews",
    "mail",
    "email",
    "outlook"
  ],
  "files": [
    "dist",
    "server.ts",
    "app.tsx",
    "contract.ts",
    "src",
    "components",
    "hooks",
    "lib",
    "skills",
    "README.md",
    "PLUGIN_OVERVIEW.md"
  ],
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "dev": "bb plugin dev .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "types:check": "env -u BB_CLI bb plugin types --check ."
  }
}
