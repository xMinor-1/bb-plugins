{
  "name": "bb-plugin-pdf-viewer",
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "bb": ">=0.39",
    "bbPluginSdk": ">=0.4.8"
  },
  "bb": {
    "name": "PDF Viewer",
    "description": "Read PDF files inside bb: opens any .pdf in a panel tab instead of downloading it, and browses a host's folders for documents.",
    "branding": {
      "icon": "./icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xMinor-1/bb-plugins.git",
    "directory": "plugins/pdf-viewer"
  },
  "keywords": [
    "bb-plugin",
    "pdf",
    "viewer",
    "documents"
  ],
  "description": "Read PDF files inside bb instead of downloading them.",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "build": "bb plugin build"
  }
}
