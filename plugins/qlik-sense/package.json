{
  "name": "bb-plugin-qlik-sense",
  "version": "0.1.1",
  "description": "Let agents read Qlik Sense Enterprise reports: two-step setup, a report catalog, and a guard that keeps company data with approved models.",
  "license": "MIT",
  "author": "Foma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xMinor-1/bb-plugins.git",
    "directory": "plugins/qlik-sense"
  },
  "type": "module",
  "keywords": [
    "bb-plugin",
    "qlik",
    "qlik-sense",
    "bi",
    "reports"
  ],
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.104"
  },
  "bb": {
    "name": "Qlik Sense",
    "description": "Agents read Qlik Sense Enterprise sheets and charts with filters. Sign in once, tick the reports agents may use, and choose which models may see the data.",
    "branding": {
      "icon": "./icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./src/host.ts"
  },
  "files": [
    "dist",
    "server.ts",
    "app.tsx",
    "contract.ts",
    "src",
    "components",
    "hooks",
    "lib",
    "skills",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "icon.svg"
  ],
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "dev": "bb plugin dev .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "QLIK_TEST_ENGINE=$(test/engine.sh) vitest run --config vitest.e2e.config.ts",
    "types:check": "env -u BB_CLI bb plugin types --check ."
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "jsonc-parser": "^3.3.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.104",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^4.1.12"
  }
}
