{
  "name": "bb-plugin-tracker-board",
  "version": "0.1.1",
  "description": "A board for a REST task tracker inside bb: cards, child tasks from templates, bulk edits and an agent that changes tasks only after you confirm in chat.",
  "license": "MIT",
  "author": "Foma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xMinor-1/bb-plugins.git",
    "directory": "plugins/tracker-board"
  },
  "type": "module",
  "keywords": [
    "bb-plugin",
    "tracker",
    "board",
    "tasks",
    "rest"
  ],
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.104"
  },
  "bb": {
    "name": "Tracker Board",
    "description": "A board and list for a REST task tracker: cards with child tasks, templates that create several tasks at once, bulk edits, and an agent that changes tasks only after you confirm in chat.",
    "branding": {
      "icon": "./icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./src/host.ts",
    "skills": [
      "skills"
    ]
  },
  "files": [
    "dist",
    "server.ts",
    "app.tsx",
    "app.css",
    "contract.ts",
    "src",
    "lib",
    "skills",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "icon.svg"
  ],
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "dev": "bb plugin dev .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types:check": "env -u BB_CLI bb plugin types --check ."
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.104",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "^29.1.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^4.1.12"
  }
}
