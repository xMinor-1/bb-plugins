{
  "name": "bb-plugin-server-status",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.39",
    "bbPluginSdk": ">=0.4.8"
  },
  "bb": {
    "name": "Server Status",
    "description": "Tracks host RAM usage as a ring around a sidebar footer button — amber from 80%, red above 90%, refreshed every five seconds. Click opens a server summary: CPU and cores, memory, swap, disk, load average, uptime, and OS and kernel version.",
    "branding": {
      "icon": "./icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xMinor-1/bb-plugins.git",
    "directory": "plugins/server-status"
  }
}
