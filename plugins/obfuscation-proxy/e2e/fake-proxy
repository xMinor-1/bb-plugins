#!/usr/bin/env node
// Stand-in for the masking proxy in e2e/masking-bar.mjs: listens on the address
// from the generated config and reports it the way the real proxy does.
const fs = require("node:fs");
const http = require("node:http");
const cfg = fs.readFileSync(process.argv[process.argv.indexOf("--config") + 1], "utf8");
const addr = /addr:\s*"([^"]+)"/.exec(cfg)[1];
const [host, port] = addr.split(":");
http.createServer((req, res) => { res.writeHead(502); res.end("stand-in"); }).listen(Number(port), host, () => {
  const line = JSON.stringify({ level: "INFO", msg: "listening", addr }) + "\n";
  process.stdout.write(line); process.stderr.write(line);
});
